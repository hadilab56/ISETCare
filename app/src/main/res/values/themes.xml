<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ISETCare" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/navy</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="H1">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <style name="Sub">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/navy</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="Btn" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="BtnOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/teal</item>
        <item name="strokeColor">@color/teal</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
