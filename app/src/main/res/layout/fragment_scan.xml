<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            style="@style/H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scanner un QR Code" />

        <TextView
            style="@style/Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Placez le QR Code de l'équipement dans le cadre pour ouvrir sa fiche." />

        <LinearLayout
            android:id="@+id/qrPanel"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_qr"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ QR ]"
                android:textColor="@color/white"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Touchez ici pour lancer le scan"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScan"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scanner" />

        <TextView
            style="@style/Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ou saisir le code de l'équipement" />

        <EditText
            android:id="@+id/code"
            style="@style/Field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PC-024"
            android:importantForAutofill="no"
            android:inputType="textCapCharacters" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpen"
            style="@style/BtnOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ouvrir la fiche" />
    </LinearLayout>
</ScrollView>
